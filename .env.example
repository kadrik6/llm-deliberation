# Copy this file to .env and fill in your own keys. .env is gitignored and
# must never be committed. Values below (questions, context, and generated
# text) are sent to the corresponding third-party provider's API -- this
# application runs locally, but it is not an offline/local-LLM system.

# Required for all runs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required only when red-team is enabled, or when CONVERGENCE_PROVIDER=gemini
GEMINI_API_KEY=

# Default profile: balanced | max | economy
LLM_PROFILE=balanced

# Default output language for CLI runs: en | et. CLI --language overrides
# this. If neither is set, defaults to "en" -- the CLI never infers a
# run's output language from the question's own language (see the
# --language help text / docs/decisions for why: a question that reads as
# confidently Estonian with no --language and no LLM_LANGUAGE set is
# refused with a hint, rather than silently producing English output).
LLM_LANGUAGE=en

# The third model can be globally enabled/disabled here.
# CLI --red-team / --no-red-team overrides this.
RED_TEAM_ENABLED=true

# Optional per-provider overrides.
# Leave blank to use the selected profile.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Ordered fallback chain tried, in order, only when GEMINI_MODEL returns a
# transient/provider-side failure (HTTP 500/502/503/504 or a clearly-labeled
# high-demand response) after exhausting its own retry budget. Never used
# for auth/billing/invalid-request errors -- those fail immediately so a
# real configuration problem is never hidden.
# Leave unset for the built-in default chain; set to an empty string to
# disable fallback entirely (only ever try GEMINI_MODEL).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# Which provider runs the convergence_analysis stage (compares each
# candidate's original analysis to its revision, and the two revisions to
# each other -- see docs/decisions/006-explicit-convergence-analysis.md).
# One of: openai | anthropic | gemini. Default: anthropic (deliberately
# different from the final synthesizer, which is always OpenAI, and not
# Gemini so this always-on stage doesn't silently require GEMINI_API_KEY).
CONVERGENCE_PROVIDER=anthropic

# Model override for the convergence analyst. Leave blank to reuse the
# chosen provider's already-configured model for the active profile.
CONVERGENCE_MODEL=

# Reasoning / thinking levels
OPENAI_EFFORT=high
ANTHROPIC_EFFORT=high
GEMINI_THINKING_LEVEL=high

# Maximum output tokens per call -- shared between reasoning/thinking
# tokens (at effort=high / thinking_level=high, the default above) and the
# visible answer, not a bound on visible text alone. See ADR 010: raised
# from 5000 after a real analysis stage truncated twice at that cap, each
# attempt consuming ~99.7-99.8% of it before finishing. Raising this does
# NOT increase real-world spend for a normal response, but it does make
# the worst-case pre-run cost estimate (and the budget admission check)
# more conservative -- see the --max-cost / web budget guidance in the
# README and ADR 010's trade-off section.
MAX_OUTPUT_TOKENS=16000
